# Server runtime environment (development shown; production values differ)

# development | test | production
NODE_ENV=development

# Port the Express server listens on
PORT=4000

# MongoDB connection string (MongoDB Atlas free tier in deployment)
MONGO_URI=mongodb://localhost:27017/interview_prep_kit

# Secret used to sign session JWTs — at least 16 chars, keep out of source control
JWT_SECRET=change-me-to-a-long-random-string

# Exact origin of the deployed/local frontend, used for CORS + cookie config
FRONTEND_ORIGIN=http://localhost:3000

# OpenAI API key — used by the pipeline's generation steps (§6.2)
OPENAI_API_KEY=

# Search API key — used by the "public discussion of interview process" step (§6.2 step 3)
SEARCH_API_KEY=

# Set to "true" only for the batch CLI running against localhost test fixtures (§11/§18).
# Never set this in the deployed web app's environment.
ALLOW_LOCAL_FETCH=false
